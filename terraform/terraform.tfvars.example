# Copie para terraform.tfvars (NAO commitar) e ajuste os valores.
# db_password deve ser definida via variavel de ambiente TF_VAR_db_password
# ou em um tfvars nao versionado, nunca hardcoded aqui.

aws_region   = "us-east-1"
environment  = "production"
project_name = "back-stage"

vpc_cidr           = "10.20.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

eks_cluster_version     = "1.30"
eks_node_instance_types = ["t3.medium"]
eks_node_desired_size   = 3
eks_node_min_size       = 2
eks_node_max_size       = 6

db_instance_class    = "db.t3.medium"
db_allocated_storage = 50
db_name              = "backstage"
db_username          = "backstage"

redis_node_type       = "cache.t3.micro"
redis_num_cache_nodes = 1
